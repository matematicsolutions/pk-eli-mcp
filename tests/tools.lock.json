        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``pk_case_search``.",
          "properties": {
            "dataset_note": {
              "default": "Corpus-based connector: judgments come from the Ibtehaj10/supreme-court-of-pak-judgments dataset on HuggingFace (1,414 Supreme Court of Pakistan judgments, full text, MIT), a static snapshot from 2024-07-26 covering a SUBSET of the Court's output - absence of a judgment here does not mean it does not exist.",
              "type": "string"
            },
            "items": {
