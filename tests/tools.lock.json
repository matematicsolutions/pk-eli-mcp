                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "eli_note": {
                    "default": "Pakistan has not deployed ELI. For statutes, eli_uri is the canonical Ministry of Law and Justice PDF URL (https://pakistancode.gov.pk/pdffiles/{law_id}); for judgments it is the HuggingFace dataset row URI. Stable and resolvable, never invented.",
