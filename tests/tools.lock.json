                "type": "object"
              },
              "type": "array"
            },
            "query": {
              "type": "string"
            },
            "total_matches": {
              "type": "integer"
            }
          },
          "required": [
            "query",
            "total_matches"
          ],
          "type": "object"
        }
      },
      "sha256": "0d4e82fd8f720834132c4cbbe2b422346708e59d2d03ebbed3dc37a3691b990a"
