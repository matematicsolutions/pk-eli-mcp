    "pk_verify_citations": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Verify Pakistani legal citations found in a text against the corpus.\n\nExtracts statute sections (\"section 302 of the Pakistan Penal Code\",\n\"section 10A of the Pakistan Study Centres Act, 1976\"), act coordinates\n(\"Act No. XLV of 1860\"), Constitution articles (\"Article 184(3) of the\nConstitution\") and Supreme Court registry citations (\"Crl.A. 93/2013\"),\nthen checks each against the local corpus. A parenthetical description\nright after a citation is content-checked with a trigram match (mismatch =\nreview signal). Non-existent sections come back with a range hint of what\nDOES exist.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "max_citations": {
              "default": 15,
              "description": "cap on citations to verify (1..30, default 15).",
              "type": "integer"
            },
            "text": {
              "description": "the text to verify (an LLM answer, a memo, a pleading).",
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "pk_verify_citations",
        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``pk_verify_citations``.",
          "properties": {
            "citations": {
              "items": {
                "additionalProperties": true,
                "description": "Verification outcome for one citation found in the input text.",
                "properties": {
                  "act_reference": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Act Reference"
                  },
                  "claim": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Claim"
                  },
                  "content_match": {
                    "anyOf": [
                      {
                        "additionalProperties": true,
                        "description": "Trigram comparison of a claimed description against the real provision.",
                        "properties": {
                          "matched": {
                            "title": "Matched",
                            "type": "boolean"
                          },
                          "method": {
                            "enum": [
                              "exact",
                              "trigram-jaccard",
                              "trigram-overlap"
                            ],
                            "title": "Method",
                            "type": "string"
                          },
                          "score": {
                            "title": "Score",
                            "type": "number"
                          }
                        },
                        "required": [
                          "matched",
                          "method",
                          "score"
                        ],
                        "title": "ContentMatch",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "detail": {
                    "title": "Detail",
                    "type": "string"
                  },
                  "human_readable_citation": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Human Readable Citation"
                  },
                  "kind": {
                    "enum": [
                      "statute",
                      "constitution",
                      "supreme_court_case",
                      "reporter_citation"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "range_hint": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Range Hint"
                  },
                  "raw": {
                    "title": "Raw",
                    "type": "string"
                  },
                  "section": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Section"
                  },
                  "source_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Source Url"
                  },
                  "status": {
                    "enum": [
                      "verified",
                      "not_found",
                      "content_mismatch",
                      "unverified"
                    ],
                    "title": "Status",
                    "type": "string"
                  },
                  "subsection": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Subsection"
                  }
                },
                "required": [
                  "raw",
                  "kind",
                  "status",
                  "detail"
                ],
                "title": "CitationCheck",
                "type": "object"
              },
              "title": "Citations",
              "type": "array"
            },
            "dataset_note": {
              "default": "Verification runs against the local corpus snapshots (statutes 2025-01-30, judgments 2024-07-26). Statute section detection reads the 'N. Heading' markers that survived OCR, so [MISSING] describes the machine-detectable text of the snapshot - treat it as a strong signal and confirm at source_url before accusing anyone. The judgment corpus is a 1,414-judgment SUBSET, so a case citation that is not found is reported as a gap, never as a hallucination. Everything the tool could not check lands in `gaps`, not in silence.",
              "title": "Dataset Note",
              "type": "string"
            },
            "failed_count": {
              "title": "Failed Count",
              "type": "integer"
            },
            "gaps": {
              "items": {
                "additionalProperties": true,
                "description": "An explicit incompleteness of the verification - never hidden in prose.",
                "properties": {
                  "citation": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Citation"
                  },
                  "gap_type": {
                    "enum": [
                      "out_of_corpus",
                      "unparseable_citation",
                      "upstream_unavailable",
                      "sections_not_checkable",
                      "subsection_not_checkable"
                    ],
                    "title": "Gap Type",
                    "type": "string"
                  },
                  "note": {
                    "title": "Note",
                    "type": "string"
                  }
                },
                "required": [
                  "gap_type",
                  "note"
                ],
                "title": "VerificationGap",
                "type": "object"
              },
              "title": "Gaps",
              "type": "array"
            },
            "status": {
              "enum": [
                "VERIFIED",
                "PARTIAL_VERIFIED",
                "HALLUCINATION_DETECTED",
                "NO_CITATIONS_FOUND"
              ],
              "title": "Status",
              "type": "string"
            },
            "summary": {
              "title": "Summary",
              "type": "string"
            },
            "total": {
              "title": "Total",
              "type": "integer"
            },
            "verified_count": {
              "title": "Verified Count",
